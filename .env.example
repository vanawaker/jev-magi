# TypeSafe API key. Leave it empty to enter a key on the page instead.
TYPESAFE_API_KEY=

# Address and port to listen on. Use HOST=0.0.0.0 to accept other devices.
HOST=127.0.0.1
PORT=3000

# Extra host names allowed to open the page, comma separated. localhost and 127.0.0.1 are always allowed.
ALLOWED_HOSTS=
