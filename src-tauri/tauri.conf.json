{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jev MAGI",
  "version": "1.0.0",
  "identifier": "io.github.vanawaker.jevmagi",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MAGI · 超高智能即時決策系統",
        "width": 1200,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "backgroundColor": "#100c06"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Entertainment",
    "shortDescription": "Three personas vote yes or no on your proposal.",
    "copyright": "Copyright (c) 2026 ZAX WEN",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
